rules_version = '2';

// ============================================================
//  Bathroom Report — Firestore security rules
//  v2.1 — Phase 1 hardening: field allowlists + type validation
//       on every public write path. No access-level changes
//       except /activity update+delete (see comment there).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    //  Shared helpers
    // ============================================================
    function signedIn() { return request.auth != null; }

    /* Admin is an explicit opt-in. This used to read `enabled != false`, which meant a missing
     * field, a null, or a typo like "no" all evaluated to admin — merely EXISTING in the admins
     * collection was enough. `enabled` only worked as an off-switch, never as the grant. */
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    // A community write must belong to the signed-in caller: the doc's clientId field
    // must equal their uid. (getEffectiveId() on the client returns the uid when signed in,
    // and every community write is sign-in-gated in the app UI.)
    function ownedByCaller() {
      return signedIn() && request.resource.data.clientId == request.auth.uid;
    }

    // Public submissions may not set moderator-only workflow fields.
    /* Mirror of fsId() in app.js and functions/index.js. 6,595 OSM-derived ids contain a slash,
     * which Firestore reads as a path separator, so the report document id uses the same
     * substitution the rest of the system does. Rules have no replace(), and a slash cannot
     * appear in a single-segment {id} wildcard anyway, so the check below reconstructs the
     * expected id from the two possible forms. */
    function fsLocId(locId) {
      return locId.split('/').join('__');
    }

    /* Reporting mute. reporters/{uid} exists ONLY for people marked for spam or muted by hand,
     * so this is a miss for effectively everyone — a rules `get` against a document that was
     * never created. `muted` must be an explicit true, the same pattern as admins.enabled: a
     * missing or malformed field must not silently mute somebody.
     *
     * mutedUntil == 0 alongside muted:true means indefinite, set by hand. Otherwise it is an
     * expiry, and the mute lapses on its own without anything having to run. */
    function notMutedFromReporting() {
      return !exists(/databases/$(database)/documents/reporters/$(request.auth.uid))
        || !(get(/databases/$(database)/documents/reporters/$(request.auth.uid)).data.muted == true)
        || (get(/databases/$(database)/documents/reporters/$(request.auth.uid)).data.mutedUntil is number
            && get(/databases/$(database)/documents/reporters/$(request.auth.uid)).data.mutedUntil != 0
            && get(/databases/$(database)/documents/reporters/$(request.auth.uid)).data.mutedUntil < request.time.toMillis());
    }

    /* Each value in a per-day hours map must be the same short window string a single-window
     * report sends ("0500-2300", "24"). Rules have no iteration, so this checks every day
     * explicitly; a day that is absent passes, since a partial week is a legitimate submission. */
    function validDayWindow(m, d) {
      return !(d in m) || (m[d] is string && m[d].size() > 0 && m[d].size() <= 24);
    }
    function validDayWindows(m) {
      return validDayWindow(m, 'sun') && validDayWindow(m, 'mon') && validDayWindow(m, 'tue')
          && validDayWindow(m, 'wed') && validDayWindow(m, 'thu') && validDayWindow(m, 'fri')
          && validDayWindow(m, 'sat');
    }

    /* Coordinates that are absent, or a real point on Earth. Latitude and longitude were accepted
     * as any number at all, so a report could carry lat:9e12 — not representable as a place, but
     * perfectly valid JSON, and it would render as a map link going nowhere. */
    function validLatOrAbsent(k) {
      return !(k in request.resource.data)
        || (request.resource.data[k] is number
            && request.resource.data[k] >= -90 && request.resource.data[k] <= 90);
    }
    function validLngOrAbsent(k) {
      return !(k in request.resource.data)
        || (request.resource.data[k] is number
            && request.resource.data[k] >= -180 && request.resource.data[k] <= 180);
    }
    // Either both coordinates or neither — half a pair locates nothing.
    function coordsPaired() {
      return ('lat' in request.resource.data) == ('lng' in request.resource.data);
    }

    /* A client-supplied timestamp inside a believable window. `ts is number` alone allowed a
     * far-future stamp, which would pin a report to the top of any queue sorted by time, and an
     * ancient one, which would bury it. 60s of slack absorbs ordinary clock skew. */
    function saneTs() {
      return request.resource.data.ts is number
        && request.resource.data.ts <= request.time.toMillis() + 60000
        && request.resource.data.ts > 1700000000000;
    }

    function hasNoModeratorFields() {
      return !request.resource.data.keys().hasAny([
        'moderatorNote','moderatorNotes','resolvedAt','resolvedBy',
        'dismissedAt','dismissedBy','closedAt','closedBy','updatedByAdmin'
      ]);
    }

    // Public submissions may omit status; if present it must start as pending.
    function startsPending() {
      return !request.resource.data.keys().hasAny(['status'])
        || request.resource.data.status == 'pending';
    }

    // Only recognized workflow states may be saved by FlushPanel.
    function validReportStatus() {
      return !request.resource.data.keys().hasAny(['status'])
        || request.resource.data.status in ['pending','resolved','dismissed'];
    }

    // ---- Phase 1 validation helpers ---------------------------------------
    // "Absent or the right type" checks — written against the FINAL document
    // (with merge writes, request.resource.data is the post-merge doc), so a
    // field a client never sends still passes.
    function numOrAbsent(k) {
      return !(k in request.resource.data) || request.resource.data[k] is number;
    }
    function strOrAbsent(k) {
      return !(k in request.resource.data) || request.resource.data[k] is string;
    }
    function mapOrAbsent(k) {
      return !(k in request.resource.data) || request.resource.data[k] is map;
    }
    // Star rating: absent, or an integer-ish number 0–5 (0 = not rated yet).
    /* A star rating is a whole number 0-5. `is number` accepted 3.7, which would have skewed the
     * average and can't be produced by the UI. `is int` rejects doubles outright. */
    /* A vote's amenity maps were validated only as `is map` — any number of keys, any values.
     * Bound both so one write can't carry a large arbitrary payload. 24 keys is well clear of the
     * ~11 amenities and store features the app actually sends. */
    /* An amenity map may only contain KNOWN keys with KNOWN values.
     *
     * Bounding the size was not enough. The Cloud Function turns these keys into Firestore field
     * paths, so a crafted key produced `amen.a.b.c.yes` — a level deeper than the schema — or
     * `amen..yes`, whose empty segment Firestore rejects outright, throwing and taking the
     * rating update down with it. The function now allowlists keys independently; this closes
     * the same hole at the door, so bad data never lands in a vote at all.
     *
     * Mirrors BATHROOM_AMENITIES and STORE_FEATURES in app.js. Adding an amenity means adding it
     * here, in AMENITY_KEYS in functions/index.js, and in app.js. Three places is the cost of
     * not letting a client name a server field path. */
    /* An admin amenity override may only hold a KNOWN answer.
     *
     * These were bounded strings of up to 24 characters, so any 24-character string was accepted
     * where only a handful of values mean anything. The app compares them literally — anything
     * else silently reads as "not set" — and the same value enum is already enforced on community
     * votes, so an admin override was the looser of the two paths. '' is the clear-this-override
     * value the panel writes. */
    function amenityValueOrAbsent(k) {
      return !(k in request.resource.data)
        /* multiPrivate joins the set: "several separate locking rooms", which is the commonest
         * convenience-store layout and had no valid value before. Spelled out rather than
         * reusing 'multiple' so stored data cannot confuse "two private rooms" with "one room
         * of stalls" — they are opposite answers to the privacy question. */
        || request.resource.data[k] in ['yes','no','unknown','single','multiple','multiPrivate',''];
    }

    function touchedIsAmenityValue(k) {
      return !touchedKeys().hasAny([k])
        /* multiPrivate joins the set: "several separate locking rooms", which is the commonest
         * convenience-store layout and had no valid value before. Spelled out rather than
         * reusing 'multiple' so stored data cannot confuse "two private rooms" with "one room
         * of stalls" — they are opposite answers to the privacy question. */
        || request.resource.data[k] in ['yes','no','unknown','single','multiple','multiPrivate',''];
    }

    /* The two vote maps take DISJOINT key sets.
     *
     * Both used to accept all eleven keys, so a vote carrying accessible:'yes' in amenities AND
     * in storeFeatures contributed two confirmations from one person — enough to reach
     * CONFIRM_THRESHOLD on its own. The app writes bathroom answers to `amenities` and store
     * answers to `storeFeatures`; nothing legitimate puts a key in both.
     *
     * Mirrors AMENITY_KEYS_BY_FIELD in functions/index.js and the two arrays in app.js. */
    function knownAmenityMap(k, allowed) {
      return !(k in request.resource.data)
        || (request.resource.data[k] is map
            && request.resource.data[k].keys().hasOnly(allowed)
            && request.resource.data[k].values().hasOnly(['yes','no','unknown','single','multiple','']));
    }

    function boundedMapOrAbsent(k, maxKeys) {
      return !(k in request.resource.data)
        || (request.resource.data[k] is map
            && request.resource.data[k].keys().size() <= maxKeys);
    }

    function boolOrAbsent(k) {
      return !(k in request.resource.data) || request.resource.data[k] is bool;
    }

    function ratingOrAbsent(k) {
      return !(k in request.resource.data)
        || (request.resource.data[k] is int
            && request.resource.data[k] >= 0
            && request.resource.data[k] <= 5);
    }
    // Bounded string: absent, or a string no longer than max chars.
    function boundedStrOrAbsent(k, max) {
      return !(k in request.resource.data)
        || (request.resource.data[k] is string
            && request.resource.data[k].size() <= max);
    }
    // The keys an UPDATE actually touches (ignores pre-existing legacy fields,
    // so old documents with retired fields can still be updated safely).
    function touchedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // UPDATE-safe validators: only enforce the type if this write is actually
    // changing the field. Legacy values a merge write carries along untouched
    // can't fail validation (and can't be modified to something invalid either).
    function touchedIsBoundedStr(k, max) {
      return !touchedKeys().hasAny([k])
        || (request.resource.data[k] is string
            && request.resource.data[k].size() <= max);
    }
    function touchedIsNum(k) {
      return !touchedKeys().hasAny([k]) || request.resource.data[k] is number;
    }
    function touchedIsMap(k) {
      return !touchedKeys().hasAny([k]) || request.resource.data[k] is map;
    }


    // ============================================================
    //  Administrator authorization (managed from the Firebase Console)
    // ============================================================
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;   // no one can grant themselves admin from a client
    }


    // ============================================================
    //  Community ratings
    // ============================================================
    // Anyone may READ ratings. Writing requires sign-in AND the doc must be the caller's
    // own vote: its id is "<locId>_<uid>" and its clientId is the caller's uid. This blocks
    // forging votes or overwriting someone else's rating.
    //
    // Phase 1 adds shape validation. saveMyVote() writes exactly these fields:
    //   store, bathroom (0–5), amenities/storeFeatures/amenityMeta (maps),
    //   clientId, locId, lastUpdated, and optionally username, ratedAt.
    function validVoteShape() {
      return strOrAbsent('locId')
        && ratingOrAbsent('store')
        && ratingOrAbsent('bathroom')
        /* Same 1..5 integer shape as the scores above — safe differs from `bathroom` in how it
         * is READ (it decays), not in what a client may write. Keeping the validator identical
         * means there is one definition of a valid rating. */
        && ratingOrAbsent('safe')
        && knownAmenityMap('amenities',
             ['restroomType','genderSplit','accessible','changing','hasRestroom'])
        && knownAmenityMap('storeFeatures',
             ['evCharging','airPump','shower','indoorSeating','wifi','grabAndGo','hotFood'])
        // amenityMeta holds per-key not-sure counters, shaped { key: { notSure: n } }, so its
        // VALUES are maps rather than the enum above. Keys are still restricted the same way.
        && boundedMapOrAbsent('amenityMeta', 24)
        && numOrAbsent('lastUpdated')
        && numOrAbsent('ratedAt')
        && boundedStrOrAbsent('username', 40)
        /* Set by the Hidden Gem Hunter achievement when someone is the first few to rate a
         * location — captured at that moment because it can't be reconstructed later. It was
         * never in the allowlist above, so from the instant the flag was set EVERY subsequent
         * write of that vote was rejected: the rating itself, and every amenity answer after it.
         * It fires only where bathroomCount < 5, i.e. almost every location nobody had rated
         * yet, so first-ever ratings at fresh locations have been failing since the achievement
         * shipped. */
        && boolOrAbsent('wasHiddenGem')
        /* Captured at the moment of rating because neither can be reconstructed later:
         * wasFirst records that nobody had rated the place yet, and wasChanged that this
         * rating replaced one you had already left. Same trap as wasHiddenGem, which was
         * once missing from the allowlist and silently rejected every write after it fired. */
        && boolOrAbsent('wasFirst')
        && boolOrAbsent('wasChanged');
    }
    match /votes/{id} {
      /* Was `if true`. Every vote carries clientId (the raw uid), locId, ratedAt and username, so
       * a public read let anyone query the collection and reconstruct WHERE A NAMED PERSON HAD
       * BEEN AND WHEN. Phase 2a closed users/{uid} for exactly this and left the collection it
       * mirrors — the weaker door on the same room.
       *
       * Owner-scoped reads still work: a query constrained by where('clientId','==',uid) is
       * provably within this rule, which is what loadAllRatings uses. Aggregates stay public,
       * because they are anonymous totals with no author attached.
       *
       * The recap used to verify each activity entry by reading the vote behind it, which needed
       * cross-user reads. That check now lives in recomputeBathroomAggregate, which deletes an
       * activity entry when its vote is deleted. */
      allow read: if signedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if ownedByCaller()
        && id == request.resource.data.locId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly([
             'store','bathroom','safe','amenities','storeFeatures','amenityMeta',
             'clientId','locId','lastUpdated','username','ratedAt','wasHiddenGem',
             'wasFirst','wasChanged'
           ])
        && validVoteShape();
      allow update: if ownedByCaller()
        && id == request.resource.data.locId + '_' + request.auth.uid
        // Allowlist what the write CHANGES (not the whole doc) so votes created
        // before these rules — possibly carrying retired fields — stay updatable.
        && touchedKeys().hasOnly([
             'store','bathroom','safe','amenities','storeFeatures','amenityMeta',
             'clientId','locId','lastUpdated','username','ratedAt','wasHiddenGem',
             'wasFirst','wasChanged'
           ])
        && validVoteShape();
      allow delete: if signedIn() && resource.data.clientId == request.auth.uid;
    }


    // ============================================================
    //  Aggregate rating totals
    // ============================================================
    // Rating totals are written ONLY by the recomputeBathroomAggregate Cloud Function (admin
    // privileges bypass rules). No client may write them — they're derived from vote docs
    // server-side, so they can't be forged or tampered with.
    match /aggregates/{id} {
      allow read: if true;
      allow write: if false;
    }


    // ============================================================
    //  Visitor tips
    // ============================================================
    // One doc per LOCATION (id = location id) holding a shared `tips` string array.
    // The app appends via arrayUnion; FlushPanel moderates via arrayRemove/arrayUnion.
    // Because the doc is shared, per-user ownership can't apply here — instead:
    //   - only the `tips` field may be touched,
    //   - it must stay a list, with a sanity cap,
    //   - non-admins may only GROW it (removal is moderation, admin-only).
    /* LEGACY shape: one shared document per location holding a `tips` string array.
     *
     * This could not be secured. The rule tried to enforce append-only by comparing list SIZE,
     * but Firestore rules cannot iterate a list, so there is no way to verify the old array is a
     * prefix of the new one. Any signed-in user could replace or reorder every existing tip as
     * long as the array did not shrink, and element types and lengths were never checked.
     *
     * Writes are now admin-only. Reads stay open so tips written under the old shape keep
     * displaying while they exist; new tips go to the entries subcollection below. Once the
     * legacy documents are confirmed empty, this block and the legacy read in loadTips can go. */
    match /tips/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* One document per tip, owned by its author. Ownership is checkable per document, which is
     * exactly what a shared array made impossible. Tips are immutable — an edit is a delete plus
     * a new entry — so there is no update path to abuse. */
    match /tips/{locId}/entries/{entryId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['text','uid','ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 50
        && request.resource.data.ts is int
        && request.resource.data.ts <= request.time.toMillis() + 60000
        && request.resource.data.ts > 1700000000000;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    /* Collection group read — FlushPanel's tips moderation view.
     *
     * The rule above governs DIRECT reads of one location's entries, which is why tips render
     * on the map: app.js reads tips/{locId}/entries per location. A collectionGroup('entries')
     * query is matched against the COLLECTION GROUP path instead, which that rule does not
     * cover, so loadTips() was denied. The panel catches that error and logs it to the console,
     * so the failure surfaced only as an empty "No tips to moderate." list.
     *
     * Admin-only on purpose: nothing public needs to read every tip in the database at once,
     * and the recursive wildcard would otherwise reach any future `entries` subcollection
     * anywhere under /documents. Rules OR together, so the public per-location read above is
     * unaffected by this block. */
    match /{path=**}/entries/{entryId} {
      allow read: if isAdmin();
    }


    // ============================================================
    //  Community activity log (feeds recap/most-recent)
    // ============================================================
    // The app only ever CREATES activity entries (addDoc in logActivity), with exactly:
    //   'tip'    → { type, ts, locId, text }
    //   'rating' → { type, ts, locId, sourceId }
    // Phase 1 change: update/delete drop from "any signed-in user" to admin-only.
    // No client code updates or deletes activity docs, so nothing breaks — this just
    // closes the hole where any account could vandalize or wipe the shared log.
    match /activity/{id} {
      allow read: if true;
      /* Type-specific requirements. Previously a 'tip' could omit text and a 'rating' could omit
       * sourceId, so the feed could be filled with entries that render as blanks or point at
       * nothing. locId and sourceId were also unbounded strings, and ts was any number — a
       * far-future timestamp would pin an entry to the top of the recap forever. */
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['type','ts','locId','text','sourceId','username'])
        && request.resource.data.type in ['tip','rating']
        && request.resource.data.ts is int
        && request.resource.data.ts <= request.time.toMillis() + 60000
        && request.resource.data.ts > 1700000000000
        && request.resource.data.locId is string
        && request.resource.data.locId.size() > 0
        && request.resource.data.locId.size() <= 200
        && (request.resource.data.type != 'tip'
            || (request.resource.data.text is string
                && request.resource.data.text.size() > 0
                && request.resource.data.text.size() <= 120))
        && (request.resource.data.type != 'rating'
            || (request.resource.data.sourceId is string
                && request.resource.data.sourceId.size() > 0
                && request.resource.data.sourceId.size() <= 280))
        /* Optional. The header ticker credits the most recent rater, which is only worth doing
         * because rating requires being within 0.3 miles of the location — the recognition is
         * earned by actually going somewhere, not by tapping from a sofa. Bounded to 40 to match
         * the votes rule. */
        && boundedStrOrAbsent('username', 40);
      allow update, delete: if isAdmin();
    }


    // ============================================================
    //  Per-user achievement progress
    // ============================================================
    // Each doc is keyed by the owner's uid; only that user may write their own.
    // Phase 1: the doc holds exactly one field — the `achievements` map.
    match /achievements/{id} {
      allow read: if true;
      allow create: if signedIn() && id == request.auth.uid
        && request.resource.data.keys().hasOnly(['achievements'])
        && request.resource.data.achievements is map;
      allow update: if signedIn() && id == request.auth.uid
        && touchedKeys().hasOnly(['achievements'])
        && touchedIsMap('achievements');
      // Owners could always delete their own doc; keep that unchanged.
      allow delete: if signedIn() && id == request.auth.uid;
    }


    // ============================================================
    //  Per-user settings (private preferences, e.g. travel mode)
    // ============================================================
    // Keyed by the owner's uid. Unlike achievements, these are PRIVATE — only the owner may read
    // or write their own doc. Writes are restricted to a known field allowlist with validated
    // values, so a client can't stash arbitrary data here.
    match /settings/{uid} {
      allow read:  if signedIn() && uid == request.auth.uid;
      /* stripPicks joins travelMode: up to three keys naming which facts show at the top of a
       * location card. Bounded on every axis a client could abuse — at most 3 entries, each a
       * short string — because this is a document the owner writes directly and an unbounded
       * list here is an unbounded document. The VALUES are not enumerated on purpose: the app's
       * fact list grows, and a rule that has to be redeployed to add a strip option would be a
       * rule that silently blocks the feature until someone remembers. An unknown key is
       * dropped client-side at read time, so a bad value costs nothing. */
      allow write: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['travelMode', 'stripPicks'])
        && (!('travelMode' in request.resource.data)
            || request.resource.data.travelMode in ['road', 'foot'])
        && (!('stripPicks' in request.resource.data) || (
             request.resource.data.stripPicks is list
             && request.resource.data.stripPicks.size() <= 3
           ));
    }


    // ============================================================
    //  Check-ins (retired)
    // ============================================================
    // The app no longer creates check-ins. Reads stay open for any legacy path; all new
    // writes are blocked.
    match /checkins/{id} {
      allow read: if true;
      allow write: if false;
    }


    // ============================================================
    //  Out-of-order reports (public, time-decaying)
    // ============================================================
    // Anyone may READ (the app derives a location's out-of-order phase from these on popup open).
    // Signed-in users may CREATE a report or a "cleared" marker for their own id. Reports are
    // immutable and never deleted from a client — the lifecycle is time-based (they simply age out
    // of the 24h window), so there's nothing to edit or remove.
    // Phase 1: exact field allowlist + types. reportOutOfOrder sends
    // { locId, locName, lat, lng, reporterId, ts, cleared:false }; clearOutOfOrder sends
    // { locId, reporterId, ts, cleared:true }.
    match /outOfOrder/{id} {
      allow read:   if true;
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.locId is string
        && request.resource.data.keys().hasOnly([
             'locId','locName','lat','lng','reporterId','ts','cleared'
           ])
        /* ts drives the entire out-of-order lifecycle and was accepted as any number. A document
         * dated years ahead either suppressed every real report at that location forever
         * (cleared:true) or pinned it broken forever (cleared:false), because the client derives
         * phase from `now - ts` and never expected a negative age. Clamped like activity and
         * hourReports; 60s of slack absorbs clock skew. */
        && request.resource.data.ts is int
        && request.resource.data.ts <= request.time.toMillis() + 60000
        && request.resource.data.ts > 1700000000000
        && request.resource.data.cleared is bool
        && boundedStrOrAbsent('locName', 120)
        && numOrAbsent('lat')
        && numOrAbsent('lng');
      allow update, delete: if false;
    }


    // ============================================================
    //  Location overrides (admin corrections)
    // ============================================================
    // The public app reads these to apply corrected hours/addresses/coordinates.
    // Only admins (FlushPanel) may create or change them.
    match /overrides/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin-authoritative amenities. Public read (everyone sees admin-set features live);
    // only admins write, and only the known amenity/feature keys are allowed.
    // Phase 1: every stored value must be a short string (the panel writes 'yes' / 'no' / '').
    match /amenityOverrides/{storeId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['restroomType','genderSplit','accessible','changing','hasRestroom','evCharging','airPump','shower','indoorSeating','wifi','grabAndGo','hotFood'])
        && amenityValueOrAbsent('restroomType')
        && amenityValueOrAbsent('genderSplit')
        && amenityValueOrAbsent('accessible')
        && amenityValueOrAbsent('changing')
        && amenityValueOrAbsent('hasRestroom')
        && amenityValueOrAbsent('evCharging')
        && amenityValueOrAbsent('airPump')
        && amenityValueOrAbsent('shower')
        && amenityValueOrAbsent('indoorSeating')
        && amenityValueOrAbsent('wifi')
        && amenityValueOrAbsent('grabAndGo')
        && amenityValueOrAbsent('hotFood');
      // Merge updates: validate only what this write changes, so a legacy field
      // riding along untouched can never block an admin edit.
      allow update: if isAdmin()
        && touchedKeys().hasOnly(['restroomType','genderSplit','accessible','changing','hasRestroom','evCharging','airPump','shower','indoorSeating','wifi','grabAndGo','hotFood'])
        && touchedIsAmenityValue('restroomType')
        && touchedIsAmenityValue('genderSplit')
        && touchedIsAmenityValue('accessible')
        && touchedIsAmenityValue('changing')
        && touchedIsAmenityValue('hasRestroom')
        && touchedIsAmenityValue('evCharging')
        && touchedIsAmenityValue('airPump')
        && touchedIsAmenityValue('shower')
        && touchedIsAmenityValue('indoorSeating')
        && touchedIsAmenityValue('wifi')
        && touchedIsAmenityValue('grabAndGo')
        && touchedIsAmenityValue('hotFood');
      allow delete: if isAdmin();
    }


    // ============================================================
    //  Reports (public submit, admin moderate)
    // ============================================================
    // NOTE: creates remain unauthenticated at the rules level for now — the app UI only
    // shows the report button to signed-in users, but requiring sign-in here is the
    // Phase 4 decision (it would also formally close the door on anonymous submissions
    // from outside the app). Phase 1 just pins the shape logReport() actually sends.
    // addr / chain / chainKey / storeNumber / city / state may be null, so only the
    // always-present primitives are type-checked.
    /* One LIVE report per person per location.
     *
     * The id is fsId(locId) + '_' + uid and creates only — Firestore refuses a create on an
     * existing document, so the second report is rejected by the same mechanism that protects
     * votes. Previously this was addDoc() with a random id and no server-side limit at all, so
     * one person could file the same complaint about the same store any number of times.
     *
     * "Live" is the operative word: resolving or dismissing in FlushPanel copies the report to
     * reportHistory and deletes it here, which is what releases the slot. Someone whose report
     * was handled can report the same place again; someone whose report is still open cannot.
     *
     * reporterId must be the caller's own uid — it drives the mute check and the spam counts in
     * FlushPanel, so a client that could put someone else's uid there could get a third party
     * muted. */
    match /reports/{id} {
      allow create: if signedIn() && startsPending() && hasNoModeratorFields()
        && id == fsLocId(request.resource.data.locId) + '_' + request.auth.uid
        && request.resource.data.reporterId == request.auth.uid
        && notMutedFromReporting()
        && request.resource.data.keys().hasOnly([
             'locId','locName','addr','chainKey','chain','storeNumber',
             'city','state','lat','lng','reporterId','reporterName','reason','ts','status'
           ])
        && request.resource.data.locId is string
        && request.resource.data.locId.size() <= 200
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 200
        && saneTs()
        && validLatOrAbsent('lat') && validLngOrAbsent('lng') && coordsPaired()
        && boundedStrOrAbsent('locName', 160)
        && boundedStrOrAbsent('reporterId', 64)
        && boundedStrOrAbsent('reporterName', 40);
      /* A reporter may read their OWN report, and only that one. Without it the client cannot
       * tell "you already reported this" apart from "the rules refused this write" — both arrive
       * as permission-denied — which is exactly how a broken create spent a day disguised as a
       * duplicate. `get` only: listing stays admin-only, so nobody can walk the queue. */
      allow get:    if isAdmin() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow list:   if isAdmin();
      allow update: if isAdmin() && validReportStatus();
      allow delete: if isAdmin();
    }


    // ============================================================
    //  Missing-location submissions (public submit, admin moderate)
    // ============================================================
    // Anonymous users CAN currently submit these (the floating "missing location" button
    // shows for everyone), so creates stay unauthenticated — requiring sign-in here is a
    // feature-removal decision reserved for Phase 4. logMissingLocation() sends exactly
    // { description, ts } plus optional lat/lng.
    match /missingReports/{id} {
      allow create: if startsPending() && hasNoModeratorFields()
        && request.resource.data.keys().hasOnly(['description','ts','lat','lng','status'])
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 600
        && saneTs()
        && validLatOrAbsent('lat') && validLngOrAbsent('lng') && coordsPaired();
      allow read:   if isAdmin();
      allow update: if isAdmin() && validReportStatus();
      allow delete: if isAdmin();
    }


    // ============================================================
    //  Reporter standing (admin-owned, one doc per flagged person)
    // ============================================================
    /* Created only when a moderator marks a report as spam or mutes somebody, so this collection
     * holds problem accounts rather than every user — which is what keeps the FlushPanel load to
     * a handful of documents no matter how the user base grows.
     *
     * Everything that carries consequence (spamCount, muted, mutedUntil, muteTier) is
     * admin-written. The single exception is blockedAttempts: a muted person's own client
     * increments it so a moderator can see somebody still trying. That is a signal, not evidence
     * — the client controls whether it sends the increment at all, so it counts the confused
     * repeat-tapper, never a determined one. It is allowlisted to that one field precisely
     * because it is the only thing here a non-admin may touch. */
    match /reporters/{uid} {
      /* get and list are split deliberately. An owner may read their OWN record — which is what
       * makes the blockedAttempts increment below possible — but listing the collection would
       * hand any signed-in user the full set of flagged accounts, so that stays admin-only. A
       * single `allow read` covering both would have granted it. */
      allow get:  if isAdmin() || (signedIn() && uid == request.auth.uid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      // Owner increment, strictly bounded: their own doc, only blockedAttempts, only upward,
      // and only by one. Cannot create the document, so it never grants a way to self-register.
      allow update: if signedIn() && uid == request.auth.uid
        && touchedKeys().hasOnly(['blockedAttempts'])
        && request.resource.data.blockedAttempts is int
        && request.resource.data.blockedAttempts ==
             ((resource.data.blockedAttempts is int ? resource.data.blockedAttempts : 0) + 1);
    }


    // ============================================================
    //  Resolved / dismissed reports (admin-only archive)
    // ============================================================
    /* Where a report goes when it is resolved or dismissed. Moving it out of `reports` is what
     * frees that person's one-live-report slot for the location, and it keeps the live queue
     * holding only open items — so FlushPanel's load stays flat instead of growing with every
     * report ever filed. Never client-readable: it carries reporterId across many locations,
     * which is exactly the visit history that closing /votes was meant to protect. */
    match /reportHistory/{id} {
      allow read, create, update, delete: if isAdmin();
    }


    // ============================================================
    //  Recovery email (server-written, owner-readable)
    // ============================================================
    /* Holds a real email address, whether it has been verified, and the hash of a pending
     * verification token. Every write goes through a Cloud Function using the Admin SDK, which
     * bypasses these rules entirely — so `allow write: if false` costs nothing and closes the
     * door on a client setting verified:true directly, which would defeat the confirmation step
     * and let somebody attach an address they do not own.
     *
     * Owner-readable so the account panel can show "confirmed" or "check your inbox" without a
     * round trip. Deliberately NOT admin-readable: moderating reports and tips never requires
     * knowing anyone's email address, and the fewer places it can be read from, the better.
     * The token is stored hashed precisely because this document IS readable. */
    match /recovery/{uid} {
      allow get:   if signedIn() && uid == request.auth.uid;
      allow list:  if false;
      allow write: if false;
    }


    // ============================================================
    //  Moderation blocklist
    // ============================================================
    // The app may check one known document id, but cannot download the whole list.
    match /blockedDevices/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    //  Leaderboard + user stats (server-derived, read-only to clients)
    // ============================================================
    // Reserved for a server-derived leaderboard. NOTE: no Cloud Function currently writes these —
    // only recomputeBathroomAggregate and recomputeHourStatus are deployed. The rules stay closed
    // (write:false) so that when a writer is added it must be server-side with admin privileges,
    // and no client can populate them in the meantime.
    match /leaderboard/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /userStats/{id} {
      allow read: if true;
      allow write: if false;
    }


    // ============================================================
    //  Public user profiles (display name + own ratings snapshot)
    // ============================================================
    // Keyed by the owner's uid. Readable by anyone (the leaderboard/credits show display names),
    // but only the owner may write their own doc.
    // Phase 1: exactly the fields saveMyVote()/loadAllRatings() write —
    // { uid, username, lastUpdated, ratings } — and uid must match the doc/caller.
    match /users/{uid} {
      /* Was `if true`. This document mirrors every one of a user's ratings under `ratings`, keyed
       * by location — so a public read exposed a complete, UID-linked history of where somebody
       * has been. Nothing needs that: app.js only ever reads the caller's OWN doc (the one-read
       * loadAllRatings path), and the leaderboard that would need cross-user reads is inert and
       * has no writer. Admins retain read for moderation. */
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','username','lastUpdated','ratings'])
        && request.resource.data.uid == uid
        && boundedStrOrAbsent('username', 40)
        && numOrAbsent('lastUpdated')
        && mapOrAbsent('ratings');
      // Merge updates: validate only what this write changes (legacy fields on
      // pre-rules docs stay readable and untouched, and can't block the write).
      // Ownership is enforced by the path (uid == auth.uid); the uid field just
      // can't be changed to anything else.
      allow update: if signedIn() && uid == request.auth.uid
        && touchedKeys().hasOnly(['uid','username','lastUpdated','ratings'])
        && (!touchedKeys().hasAny(['uid']) || request.resource.data.uid == uid)
        && touchedIsBoundedStr('username', 40)
        && touchedIsNum('lastUpdated')
        && touchedIsMap('ratings');
      // Owners could always delete their own doc; keep that unchanged.
      allow delete: if signedIn() && uid == request.auth.uid;
    }



    // ============================================================
    //  Community hours reports (public submit own; consensus is server-derived)
    // ============================================================
    // A signed-in user may write ONLY their own report doc (id == uid) under a store. value/kind
    // are shape-validated here; the recomputeHourStatus Cloud Function is the real validator and
    // the only writer of verified state (in hourStatus). No client can forge "verified".
    match /hourReports/{storeId}/submissions/{uid} {
      allow read: if signedIn();
      /* `value` was accepted as ANY type and submittedAt as any number. A single-window report is
       * a short string ("0500-2300" or "24"); a per-day report is a small map. submittedAt is
       * clamped to a sane window so a far-future stamp can't outrank real submissions in the
       * consensus the Cloud Function derives. */
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','value','kind','submittedAt','schemaVersion'])
        && request.resource.data.kind in ['single','perday']
        && request.resource.data.schemaVersion == 1
        && request.resource.data.submittedAt is int
        && request.resource.data.submittedAt <= request.time.toMillis() + 60000
        && request.resource.data.submittedAt > 1700000000000
        && (
             (request.resource.data.kind == 'single'
               && request.resource.data.value is string
               && request.resource.data.value.size() > 0
               && request.resource.data.value.size() <= 24)
             ||
             (request.resource.data.kind == 'perday'
               && request.resource.data.value is map
               && request.resource.data.value.keys().size() > 0
               && request.resource.data.value.keys().size() <= 7
               /* Size alone let anything through: { banana: 12345 } was a valid submission. The
                * Cloud Function's canonicaliser rejected it later, but the document was already
                * written and the trigger had already fired. Constrain both halves here — the day
                * names match DAYS in functions/index.js, and each window is the same short string
                * a single-window report uses. */
               && request.resource.data.value.keys().hasOnly(['sun','mon','tue','wed','thu','fri','sat'])
               && validDayWindows(request.resource.data.value))
           );
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Server-derived hours consensus. Written ONLY by the recomputeHourStatus Cloud Function
    // (admin privileges bypass rules). Public read (drives display / bake review); no client write.
    match /hourStatus/{storeId} {
      allow read: if true;
      allow write: if false;
    }

    // ============================================================
    //  Default deny — anything not listed above is inaccessible
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
